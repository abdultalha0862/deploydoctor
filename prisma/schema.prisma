generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Incident {
  id             String           @id @default(uuid())
  title          String
  description    String?
  environment    String?
  logs           String?
  diagnosis      String?
  likelyCause    String?
  evidence       Json?
  recommendation String?
  confidence     Float?
  status         IncidentStatus   @default(OPEN)
  severity       IncidentSeverity @default(MEDIUM)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}